---
import type { Post } from '../lib/data';
import { formatDate, isoDate, vkTextToHtml, excerpt, withBase, rub } from '../lib/format';
import PhotoGrid from './PhotoGrid.astro';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  compact?: boolean; // краткий вид для списка
  full?: boolean; // полный текст (страница поста)
}
const { post: p, compact = false, full = false } = Astro.props;
const CAT_LABEL: Record<string, { label: string; cls: string }> = {
  fundraising: { label: 'Сбор', cls: 'pill--amber' },
  report: { label: 'Отчёт', cls: 'pill--green' },
  adopted: { label: 'Нашли дом', cls: 'pill--green' },
  lookingHome: { label: 'Ищет дом', cls: '' },
  needs: { label: 'Нужды', cls: 'pill--amber' },
  volunteers: { label: 'Волонтёры', cls: '' },
};
const cats = p.categories.filter((c) => CAT_LABEL[c]);
const postUrl = withBase(`/news/${p.id}/`);
const bodyHtml = full ? vkTextToHtml(p.text || p.repost?.text || '') : vkTextToHtml(p.text || p.repost?.text || '', { maxParagraphs: compact ? 1 : 3 });
const isTruncated = !full && (p.text || '').split(/\n{2,}/).length > (compact ? 1 : 3);
---
<article class:list={['post', { 'post--compact': compact, 'post--full': full }]}>
  {cats.length > 0 && (
    <div class="post__cats">
      {cats.map((c) => <span class:list={['pill', CAT_LABEL[c].cls]}>{CAT_LABEL[c].label}</span>)}
    </div>
  )}
  <div class="post__meta muted small">
    <time datetime={isoDate(p.date)}>{formatDate(p.date)}</time>
    {p.repost && <span> · репост</span>}
  </div>
  {!full && p.title && <h3 class="post__title"><a href={postUrl}>{p.title}</a></h3>}
  {compact ? (
    <p class="post__excerpt">{excerpt(p.text || p.repost?.text || '', 160)}</p>
  ) : (
    <div class="post__body prose" set:html={bodyHtml} />
  )}
  {!compact && isTruncated && <a class="post__more" href={postUrl}>Читать полностью <Icon name="arrow" size={16} /></a>}

  {p.fundraising && (p.fundraising.goal || p.fundraising.raised) && (
    <div class="post__fund">
      <div class="row" style="justify-content:space-between">
        <strong>{p.fundraising.raised != null ? `Собрано ${rub(p.fundraising.raised)}` : 'Сбор открыт'}</strong>
        {p.fundraising.goal != null && <span class="muted">цель {rub(p.fundraising.goal)}</span>}
      </div>
      {p.fundraising.percent != null && <div class="progress" role="progressbar" aria-valuenow={p.fundraising.percent} aria-valuemin="0" aria-valuemax="100"><span style={`width:${p.fundraising.percent}%`}></span></div>}
      <a class="btn btn--primary btn--sm" href={withBase('/help/#donate')}><Icon name="heart" size={16} /> Помочь в сборе</a>
    </div>
  )}

  {p.photos.length > 0 && (compact ? (
    <a href={postUrl} class="post__thumb ratio ratio--16x9"><img src={p.photos[0].thumb || p.photos[0].src} alt="" loading="lazy" decoding="async" /></a>
  ) : (
    <PhotoGrid photos={p.photos} max={full ? 10 : 4} alt="" />
  ))}

  {!compact && p.videos.length > 0 && (
    <div class="post__videos">
      {p.videos.map((v) => (
        <a class="post__video" href={v.url} target="_blank" rel="noopener">
          {v.thumb && <img src={v.thumb} alt="" loading="lazy" />}
          <span class="post__video-label">▶ {v.title || 'Видео'}{v.duration ? ` · ${Math.floor(v.duration / 60)}:${String(v.duration % 60).padStart(2, '0')}` : ''}</span>
        </a>
      ))}
    </div>
  )}
  {!compact && p.links.length > 0 && (
    <div class="post__links">
      {p.links.map((l) => (
        <a class="post__link" href={l.url} target="_blank" rel="noopener nofollow">
          {l.image && <img src={l.image} alt="" loading="lazy" />}
          <span><strong>{l.title}</strong>{l.description && <span class="muted small"> — {excerpt(l.description, 100)}</span>}</span>
        </a>
      ))}
    </div>
  )}
  {!compact && p.docs.length > 0 && (
    <div class="post__docs">
      {p.docs.map((d) => (
        <a class="pill" href={d.url} target="_blank" rel="noopener"><Icon name="doc" size={14} /> {d.title}</a>
      ))}
    </div>
  )}
  <div class="post__footer">
    <a class="post__vk" href={p.url} target="_blank" rel="noopener"><Icon name="vk" size={16} /> Открыть во ВКонтакте</a>
    {typeof p.likes === 'number' && p.likes > 0 && <span class="muted small">♥ {p.likes}</span>}
  </div>
</article>

<style>
  .post {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .post--compact {
    padding: 16px;
    gap: 8px;
  }
  .post--full {
    border: 0;
    padding: 0;
    background: transparent;
    gap: 16px;
  }
  .post__cats {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .post__title {
    font-size: 1.2rem;
  }
  .post__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .post__title a:hover {
    color: var(--green);
  }
  .post__excerpt {
    color: var(--ink-2);
    margin: 0;
  }
  .post__body :global(p) {
    overflow-wrap: anywhere;
  }
  .post__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    text-decoration: none;
  }
  .post__fund {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border-radius: 12px;
    background: var(--amber-soft);
  }
  .post__thumb {
    border-radius: var(--radius-sm);
  }
  .post__videos,
  .post__links,
  .post__docs {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .post__docs {
    flex-direction: row;
    flex-wrap: wrap;
  }
  .post__video {
    position: relative;
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--ink);
    aspect-ratio: 16 / 9;
  }
  .post__video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }
  .post__video-label {
    position: absolute;
    left: 12px;
    bottom: 10px;
    color: #fff;
    font-weight: 700;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }
  .post__link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .post__link img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 8px;
  }
  .post__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 6px;
  }
  .post__vk {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }
  .post__vk:hover {
    color: var(--green);
  }
</style>
