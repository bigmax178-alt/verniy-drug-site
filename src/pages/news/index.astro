---
import Base from '../../layouts/Base.astro';
import config from '../../../site.config.mjs';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import { newsPosts, pinnedPost, postsSource } from '../../lib/data';
import { withBase } from '../../lib/format';

const PAGE = 24;
const list = newsPosts.slice(0, PAGE * 4); // до ~100 постов на одной странице с догрузкой
const filters = [
  { key: '', label: 'Все' },
  { key: 'fundraising', label: 'Сборы' },
  { key: 'report', label: 'Отчёты' },
  { key: 'adopted', label: 'Нашли дом' },
  { key: 'lookingHome', label: 'Ищут дом' },
  { key: 'needs', label: 'Нужды' },
];
---
<Base title="Новости приюта" description="Лента приюта «Верный друг» из ВКонтакте: сборы, отчёты, кто нашёл дом и кто ещё ждёт.">
  <section class="section section--tight">
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Новости</div>
        <h1>Что происходит в приюте</h1>
        <p class="lede">Это лента группы ВКонтакте — приют пишет туда, а сайт подтягивает записи сам. Подписаться на новости можно <a href={config.vk.url} target="_blank" rel="noopener">в группе</a> или по <a href={withBase('/rss.xml')}>RSS</a>.</p>
      </div>
      <div class="filters" role="group" aria-label="Фильтр по типу">
        {filters.map((f) => <button type="button" class="chip" data-cat={f.key} aria-pressed={f.key === '' ? 'true' : 'false'}>{f.label}</button>)}
      </div>
      {pinnedPost && (
        <div class="pinned">
          <div class="pinned__label"><Icon name="paw" size={14} /> Закреплено приютом</div>
          <PostCard post={pinnedPost} compact />
        </div>
      )}
      <div class="grid grid--3" id="posts">
        {list.map((p, i) => (
          <div class="post-wrap" data-cats={p.categories.join(' ')} data-i={i} hidden={i >= PAGE}>
            <PostCard post={p} compact />
          </div>
        ))}
      </div>
      <p class="muted small" id="empty" hidden>Записей такого типа пока нет среди последних постов.</p>
      <div class="row" style="justify-content:center;margin-top:24px">
        <button type="button" class="btn btn--ghost" id="more" data-page={PAGE}>Показать ещё</button>
        <a class="btn btn--soft" href={config.vk.url} target="_blank" rel="noopener"><Icon name="vk" size={16} /> Вся история в группе</a>
      </div>
      {postsSource === 'seed' && <p class="small muted" style="margin-top:16px">Показаны примеры записей; после подключения ВКонтакте лента обновляется автоматически каждые полчаса.</p>}
    </div>
  </section>
</Base>

<script>
  const wraps = [...document.querySelectorAll<HTMLElement>('#posts .post-wrap')];
  const more = document.getElementById('more') as HTMLButtonElement;
  const empty = document.getElementById('empty')!;
  const PAGE = Number(more.dataset.page);
  let cat = new URLSearchParams(location.search).get('filter') || '';
  let shown = PAGE;

  function apply() {
    let matched = 0;
    for (const w of wraps) {
      const ok = !cat || (w.dataset.cats || '').split(' ').includes(cat);
      if (ok) matched++;
      w.hidden = !ok || matched > shown;
    }
    more.hidden = matched <= shown;
    empty.hidden = matched > 0;
  }
  document.querySelectorAll<HTMLButtonElement>('.chip[data-cat]').forEach((b) => {
    if (b.dataset.cat === cat) document.querySelectorAll('.chip[data-cat]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    b.addEventListener('click', () => {
      cat = b.dataset.cat || '';
      shown = PAGE;
      document.querySelectorAll('.chip[data-cat]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const url = new URL(location.href);
      cat ? url.searchParams.set('filter', cat) : url.searchParams.delete('filter');
      history.replaceState(null, '', url);
      apply();
    });
  });
  more.addEventListener('click', () => {
    shown += PAGE;
    apply();
  });
  apply();
</script>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 820px;
    margin-bottom: 20px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }
  .chip {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: var(--surface);
    font: 700 0.9rem var(--font-body);
    color: var(--ink-2);
    cursor: pointer;
    min-height: 38px;
  }
  .chip[aria-pressed='true'] {
    border-color: var(--green);
    background: var(--green-soft);
    color: var(--green);
  }
  .pinned {
    margin-bottom: 20px;
  }
  .pinned__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }
  .post-wrap {
    display: contents;
  }
  .post-wrap[hidden] {
    display: none;
  }
</style>
