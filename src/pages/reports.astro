---
import Base from '../layouts/Base.astro';
import config from '../../site.config.mjs';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { reportPosts, reportTopics, topicByKey } from '../lib/data';
import { withBase, vkTextToHtml, formatDate, excerpt } from '../lib/format';

const donationsTopic = topicByKey('donations');
const d = config.donate.org;
const docs = [
  { title: 'Оферта о пожертвовании', href: withBase('/docs/offer/'), note: 'условия, на которых приют принимает помощь' },
  { title: 'Политика обработки персональных данных', href: withBase('/docs/privacy/'), note: '152-ФЗ' },
];
---
<Base title="Отчёты и документы" description="Финансовые отчёты приюта «Верный друг»: чеки, движения по счёту АНО и карте, отчёты по сборам. Реквизиты и документы организации.">
  <section class="section section--tight">
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Прозрачность</div>
        <h1>Отчёты, чеки и документы</h1>
        <p class="lede">Приют публикует чеки и движения по счёту в обсуждениях группы, а после каждого сбора — пост «спасибо» с подтверждением. Здесь всё это собрано в одном месте.</p>
      </div>

      <div class="grid grid--3 topics">
        {reportTopics.length > 0 ? reportTopics.map((t) => {
          const lastWithPhotos = [...t.comments].reverse().find((c) => c.photos.length);
          return (
            <a class="card card--pad topic" href={t.url} target="_blank" rel="noopener">
              {lastWithPhotos && <PhotoGrid photos={lastWithPhotos.photos} max={1} linkToFull={false} />}
              <h3>{t.title.replace(/^🐾\s*/, '')}</h3>
              <span class="muted small">{t.commentsCount} записей · обновлено {formatDate(t.updated, { withYear: true })}</span>
              <span class="topic__more">Открыть в группе <Icon name="external" size={14} /></span>
            </a>
          );
        }) : (
          (config.vk.topics.reports as number[]).map((id) => (
            <a class="card card--pad topic" href={`https://vk.com/topic-${config.vk.groupId}_${id}`} target="_blank" rel="noopener">
              <h3>Финансовый отчёт (обсуждение в группе)</h3>
              <span class="topic__more">Открыть в группе <Icon name="external" size={14} /></span>
            </a>
          ))
        )}
      </div>
    </div>
  </section>

  {reportPosts.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head">
          <div><div class="eyebrow">Из ленты</div><h2>Благодарности и отчёты по сборам</h2></div>
          <a class="btn btn--ghost btn--sm" href={withBase('/news/?filter=report')}>Все <Icon name="arrow" size={16} /></a>
        </div>
        <div class="grid grid--3">
          {reportPosts.slice(0, 9).map((p) => <PostCard post={p} compact />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container two-col">
      <div class="card card--pad">
        <h2 style="font-size:1.4rem;margin-bottom:12px">Организация</h2>
        <dl class="org">
          <dt>Полное название</dt><dd>{d.name}</dd>
          <dt>ИНН / КПП</dt><dd>{d.inn} / {d.kpp}</dd>
          <dt>ОГРН</dt><dd>{d.ogrn}</dd>
          <dt>Расчётный счёт</dt><dd>{d.account}, {d.bank}, БИК {d.bik}</dd>
          <dt>Руководитель</dt><dd>{config.contacts[0].name}, {config.contacts[0].phone}</dd>
          <dt>Адрес приюта</dt><dd>{config.location}</dd>
        </dl>
        <p class="small muted">Проверить организацию можно на сайте ФНС по ИНН. {donationsTopic && <>О переводах приют просит писать в обсуждение <a href={donationsTopic.url} target="_blank" rel="noopener">«Пожертвования приюту»</a> — так сходится отчёт.</>}</p>
      </div>
      <div class="card card--pad">
        <h2 style="font-size:1.4rem;margin-bottom:12px">Документы</h2>
        <ul class="docs">
          {docs.map((x) => (
            <li><a href={x.href}><Icon name="doc" size={16} /> {x.title}</a><span class="muted small"> — {x.note}</span></li>
          ))}
        </ul>
        <p class="small muted">Устав и свидетельство о регистрации АНО приют предоставляет по запросу — напишите в группу.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 820px;
    margin-bottom: 24px;
  }
  .topic {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: var(--ink);
  }
  .topic:hover {
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .topic h3 {
    font-size: 1.1rem;
  }
  .topic__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--green);
    margin-top: auto;
  }
  .two-col {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
  }
  .org {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 16px;
    margin: 0 0 14px;
    font-size: 0.95rem;
  }
  .org dt {
    color: var(--muted);
  }
  .org dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .docs {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .docs a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
</style>
