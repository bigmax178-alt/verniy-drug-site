---
import Base from '../layouts/Base.astro';
import config from '../../site.config.mjs';
import Icon from '../components/Icon.astro';
import DonateWidget from '../components/DonateWidget.astro';
import AnimalCard from '../components/AnimalCard.astro';
import { sectionText, lookingAnimals, topicByKey } from '../lib/data';
import { vkTextToHtml, withBase, telHref, formatDate, rub } from '../lib/format';

const needs = sectionText('needs', 'needs', { comments: 2 });
const points = sectionText('collectionPoints', 'collect', { comments: 3 });
const guardianship = sectionText('guardianship', 'guardianship', { comments: 2 });
const faqTopic = topicByKey('faq');
const guardianPicks = [...lookingAnimals].sort(() => 0.5).slice(0, 4);
const curator = config.contacts.find((c) => c.role.includes('куратор')) || config.contacts[0];
const head = config.contacts[0];
const d = config.donate;

// Убираем из seed-текста нужд служебные строки, если это ещё старая страница Tilda.
const cleanNeeds = needs.text.replace(/^Нужды приюта\n/, '');
---
<Base title="Как помочь приюту" description="Пожертвовать приюту «Верный друг» за минуту: QR-код, СБП, счёт АНО, ежемесячная помощь и опекунство. А ещё — корм, вещи, пункты сбора и волонтёрство.">
  <section class="section section--tight">
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Как помочь</div>
        <h1>Каждый способ помощи здесь — настоящий и нужный</h1>
        <p class="lede">Деньги идут на корм, ветеринара и содержание вольеров; вещи — прямо в приют; руки и машины — туда, куда не доезжает никто другой. Выберите то, что удобно вам.</p>
        <nav class="anchors" aria-label="Разделы страницы">
          <a href="#donate"><Icon name="heart" size={16} /> Деньгами</a>
          <a href="#guardianship"><Icon name="paw" size={16} /> Опекунство</a>
          <a href="#needs"><Icon name="gift" size={16} /> Корм и вещи</a>
          <a href="#points"><Icon name="map" size={16} /> Куда привезти</a>
          <a href="#volunteer"><Icon name="car" size={16} /> Волонтёрам</a>
        </nav>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <DonateWidget />
    </div>
  </section>

  <section class="section section--alt" id="guardianship">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Опекунство</div>
          <h2>Взять под крыло одного подопечного</h2>
          <p>{rub(d.guardianshipMonthly)} в месяц — и у конкретной собаки или кошки появляется свой человек. Опекун получает фото и новости, может приезжать гулять, а на вольере появляется табличка с его именем.</p>
        </div>
        <a class="btn btn--primary" href={withBase('/animals/')}><Icon name="paw" size={16} /> Выбрать подопечного</a>
      </div>
      <div class="two-col">
        <div class="prose card card--pad guard-rules">
          <h3>Условия — словами приюта</h3>
          <div set:html={vkTextToHtml(guardianship.text)} />
          <p class="small muted" style="margin-top:14px">
            {guardianship.source === 'vk' ? `Из обсуждения группы, обновлено ${formatDate(guardianship.updated!)}. ` : 'Стартовый текст со старого сайта приюта. '}
            <a href={guardianship.url} target="_blank" rel="noopener">Открыть обсуждение и записаться →</a>
          </p>
        </div>
        <div class="stack">
          <div class="card card--pad card--soft">
            <h3 style="margin-bottom:8px">Как стать опекуном</h3>
            <ol class="steps">
              <li>Выберите животное в разделе <a href={withBase('/animals/')}>«Ищут дом»</a> и нажмите «Стать опекуном».</li>
              <li>Напишите в <a href={guardianship.url} target="_blank" rel="noopener">обсуждении «Опекунство»</a> или куратору <a href={config.vk.curatorProfile} target="_blank" rel="noopener">Анастасии</a> — приют занесёт вас в список.</li>
              <li>Переводите {rub(d.guardianshipMonthly)} раз в месяц, когда удобно. В назначении платежа — только «Благотворительный взнос», без клички: так просит бухгалтерия приюта.</li>
              <li>О переводе отпишитесь куратору с пометкой, для кого он.</li>
            </ol>
          </div>
          <div class="grid grid--2">
            {guardianPicks.map((a) => <AnimalCard animal={a} />)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="needs">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Корм и вещи</div>
          <h2>Что нужно приюту прямо сейчас</h2>
          <p>Список ведёт сам приют в обсуждении «Наши нужды» — здесь он появляется автоматически. Проще всего заказать доставку сразу в приют.</p>
        </div>
      </div>
      <div class="two-col two-col--rev">
        <div class="stack">
          <a class="card card--pad way-card" href={d.murzikUrl} target="_blank" rel="noopener">
            <span class="way-card__icon"><Icon name="gift" size={22} /></span>
            <div>
              <h3>Заказать в «Мурзике» с доставкой в приют</h3>
              <p class="muted small">Благотворительная страница приюта в зоомагазине: корм и лекарства с ярлыком «самое нужное», можно оплатить часть большого мешка. Привозят прямо в приют, приют публикует фотоотчёт.</p>
              <span class="way-card__more">murzikshop.ru <Icon name="external" size={14} /></span>
            </div>
          </a>
          <div class="card card--pad">
            <h3 style="margin-bottom:6px">Заказ с маркетплейса в пункт выдачи в Первомайском</h3>
            <p class="muted small">Ozon, Wildberries или Яндекс Маркет — укажите пункт выдачи рядом с приютом, а штрихкод посылки отправьте Ксении. Волонтёры заберут.</p>
            <ul class="pickup">
              {d.pickupPoints.map((p) => (
                <li><b>{p.service}</b> — {p.address}{p.note ? <span class="muted"> ({p.note})</span> : null}</li>
              ))}
            </ul>
            <p class="small"><Icon name="whatsapp" size={14} /> {d.pickupNote} <a href={telHref(head.tel)}>{head.phone}</a></p>
          </div>
        </div>
        <div class="card card--pad prose needs-text">
          <h3>Список нужд</h3>
          <div set:html={vkTextToHtml(cleanNeeds)} />
          <p class="small muted" style="margin-top:14px">
            {needs.source === 'vk' ? `Обновлено приютом ${formatDate(needs.updated!)}. ` : 'Стартовый список со старого сайта приюта; после подключения ВКонтакте здесь будет актуальный. '}
            <a href={needs.url} target="_blank" rel="noopener">Обсуждение «Наши нужды» →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="points">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Куда привезти</div>
          <h2>Пункты сбора у волонтёров в Петербурге и области</h2>
          <p>Передать можно только по предварительной договорённости — напишите или позвоните волонтёру пункта заранее. Если пункта рядом нет, приют постарается найти автоволонтёра.</p>
        </div>
      </div>
      <div class="card card--pad prose points-text">
        <div set:html={vkTextToHtml(points.text)} />
        <p class="small muted" style="margin-top:14px">
          {points.source === 'vk' ? `Из обсуждения группы, обновлено ${formatDate(points.updated!)}. ` : 'Стартовый список со старого сайта; актуальный подтянется из ВКонтакте. '}
          <a href={points.url} target="_blank" rel="noopener">Обсуждение «Пункты сбора» →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="volunteer">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Волонтёрам</div>
          <h2>Приют в лесу — руки и машины нужны сильнее денег</h2>
          <p>Приют далеко за городом, поэтому самая острая проблема — транспорт и люди на месте. Даже одна поездка в месяц — большая помощь.</p>
        </div>
      </div>
      <div class="grid grid--3">
        <div class="card card--pad vol">
          <span class="way-card__icon"><Icon name="car" size={22} /></span>
          <h3>Автоволонтёр</h3>
          <p class="muted">Довезти корм с пункта сбора до приюта, отвезти животное в клинику, привезти гостей от метро Девяткино.</p>
        </div>
        <div class="card card--pad vol">
          <span class="way-card__icon"><Icon name="paw" size={22} /></span>
          <h3>Помощь на месте</h3>
          <p class="muted">Выгул собак, уборка, мелкий ремонт вольеров, социализация пугливых — в приёмные дни, по договорённости.</p>
        </div>
        <div class="card card--pad vol">
          <span class="way-card__icon"><Icon name="home" size={22} /></span>
          <h3>Передержка и репосты</h3>
          <p class="muted">Временно приютить животное после операции или сделать репост «ищет дом» — тоже волонтёрство.</p>
        </div>
      </div>
      <div class="row" style="margin-top:20px">
        <a class="btn btn--green" href={telHref(curator.tel)}><Icon name="phone" size={16} /> {curator.phone} · {curator.name}, куратор</a>
        <a class="btn btn--ghost" href={config.vk.url} target="_blank" rel="noopener"><Icon name="vk" size={16} /> Написать в группу</a>
      </div>
      {faqTopic && (
        <p class="small muted" style="margin-top:16px">Остались вопросы? Есть обсуждение <a href={faqTopic.url} target="_blank" rel="noopener">«Ваши вопросы»</a> — приют отвечает там.</p>
      )}
    </div>
  </section>
</Base>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 820px;
  }
  .anchors {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .anchors a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .anchors a:hover {
    border-color: var(--green);
    color: var(--green);
  }
  .two-col {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .two-col--rev {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  .guard-rules h3,
  .needs-text h3 {
    margin-bottom: 10px;
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding-left: 1.2em;
  }
  .way-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
    align-items: start;
  }
  .way-card:hover {
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .way-card h3 {
    margin-bottom: 4px;
  }
  .way-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--green-soft);
    color: var(--green);
    display: grid;
    place-items: center;
    flex: none;
  }
  .way-card__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--green);
    margin-top: 6px;
  }
  .pickup {
    margin: 10px 0;
    padding-left: 1.2em;
    font-size: 0.95rem;
  }
  .pickup li {
    margin-bottom: 4px;
  }
  .vol {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .vol p {
    font-size: 0.97rem;
  }
  section[id] {
    scroll-margin-top: calc(var(--header-h) + 8px);
  }
</style>
