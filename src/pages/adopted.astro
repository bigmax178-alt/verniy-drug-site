---
import Base from '../layouts/Base.astro';
import config from '../../site.config.mjs';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { adoptedPosts, topicByKey, stats } from '../lib/data';
import { withBase, vkTextToHtml, formatDate } from '../lib/format';

const graduates = topicByKey('graduates');
const greetings = graduates ? graduates.comments.filter((c) => c.text.length > 20 || c.photos.length).slice(-24).reverse() : [];
---
<Base title="Нашли дом" description={`Больше ${stats.adopted} собак и кошек из приюта «Верный друг» уехали в семьи. Истории и приветы от выпускников.`}>
  <section class="section section--tight">
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Нашли дом</div>
        <h1>Больше {stats.adopted} хвостов уехали домой — и это лучшая часть работы приюта</h1>
        <p class="lede">Здесь собираются записи о тех, кто нашёл семью, и «приветы» от выпускников, которые присылают новые хозяева. Если сомневаетесь, брать ли животное из приюта, — почитайте.</p>
      </div>
      {adoptedPosts.length > 0 ? (
        <div class="grid grid--3">
          {adoptedPosts.slice(0, 30).map((p) => <PostCard post={p} compact />)}
        </div>
      ) : (
        <div class="card card--pad">
          <p>Как только приют опубликует запись о новом доме (или отметит пост хэштегом <code>#дома</code>), она появится здесь. А пока — приветы от выпускников ниже и <a href={config.vk.url} target="_blank" rel="noopener">лента группы</a>.</p>
        </div>
      )}
    </div>
  </section>

  {greetings.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head">
          <div><div class="eyebrow">Из обсуждения</div><h2>«Приветы» от наших выпускников</h2><p>Пишут новые хозяева — прямо в группе, тема «{graduates!.title.replace(/^🐾/, '').trim()}».</p></div>
          <a class="btn btn--ghost btn--sm" href={graduates!.url} target="_blank" rel="noopener"><Icon name="vk" size={16} /> Все приветы</a>
        </div>
        <div class="grid grid--3">
          {greetings.map((c) => (
            <div class="card card--pad greet">
              {c.photos.length > 0 && <PhotoGrid photos={c.photos} max={2} />}
              {c.text && <div class="prose small" set:html={vkTextToHtml(c.text, { maxParagraphs: 3 })} />}
              <span class="muted small">{formatDate(c.date, { withYear: true })}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container card card--pad card--soft cta">
      <div>
        <h2>Следующим может стать ваш</h2>
        <p>{stats.dogs} собак и {stats.cats} кошек ждут в приюте. Посмотрите, кто ищет дом, — или помогите тем, кто пока остаётся.</p>
      </div>
      <div class="row">
        <a class="btn btn--green" href={withBase('/animals/')}><Icon name="paw" size={16} /> Ищут дом</a>
        <a class="btn btn--primary" href={withBase('/help/#donate')}><Icon name="heart" size={16} /> Помочь</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 820px;
    margin-bottom: 24px;
  }
  .greet {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .cta p {
    color: var(--ink-2);
    max-width: 50ch;
    margin-top: 6px;
  }
  code {
    background: var(--surface-2);
    padding: 1px 6px;
    border-radius: 6px;
  }
</style>
