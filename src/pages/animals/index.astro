---
import Base from '../../layouts/Base.astro';
import config from '../../../site.config.mjs';
import Icon from '../../components/Icon.astro';
import AnimalCard from '../../components/AnimalCard.astro';
import { lookingAnimals, dogs, cats, animalsSource, plural, sectionText } from '../../lib/data';
import { withBase, vkTextToHtml } from '../../lib/format';

const rules = sectionText('adoptionRules', undefined, { comments: 2 });
const all = [...lookingAnimals].sort((a, b) => (b.date || 0) - (a.date || 0) || a.name.localeCompare(b.name, 'ru'));
const traitSet = [...new Set(all.flatMap((a) => a.traits))];
---
<Base title="Собаки и кошки ищут дом" description={`${dogs.length} собак и ${cats.length} кошек из приюта «Верный друг» ждут семью. Истории, фото, характер — и как забрать домой или стать опекуном.`}>
  <section class="section section--tight">
    <div class="container">
      <div class="page-head">
        <div class="eyebrow">Ищут дом</div>
        <h1>{dogs.length} {plural(dogs.length, 'собака', 'собаки', 'собак')} и {cats.length} {plural(cats.length, 'кошка', 'кошки', 'кошек')} ждут своего человека</h1>
        <p class="lede">Все они привиты и под присмотром ветеринара, у каждого — своя история. Приезжайте познакомиться в приёмный день или начните с опекунства.</p>
      </div>

      <form class="filters" id="filters" aria-label="Фильтры" onsubmit="return false">
        <div class="filters__group" role="group" aria-label="Кто">
          <button type="button" class="chip" data-f="kind" data-v="" aria-pressed="true">Все <span class="chip__n">{all.length}</span></button>
          <button type="button" class="chip" data-f="kind" data-v="dog" aria-pressed="false"><Icon name="dog" size={16} /> Собаки <span class="chip__n">{dogs.length}</span></button>
          <button type="button" class="chip" data-f="kind" data-v="cat" aria-pressed="false"><Icon name="cat" size={16} /> Кошки <span class="chip__n">{cats.length}</span></button>
        </div>
        <div class="filters__group" role="group" aria-label="Пол">
          <button type="button" class="chip" data-f="sex" data-v="" aria-pressed="true">Любой пол</button>
          <button type="button" class="chip" data-f="sex" data-v="m" aria-pressed="false">Мальчики</button>
          <button type="button" class="chip" data-f="sex" data-v="f" aria-pressed="false">Девочки</button>
        </div>
        <div class="filters__group" role="group" aria-label="Возраст">
          <button type="button" class="chip" data-f="age" data-v="" aria-pressed="true">Любой возраст</button>
          <button type="button" class="chip" data-f="age" data-v="young" aria-pressed="false">До 3 лет</button>
          <button type="button" class="chip" data-f="age" data-v="adult" aria-pressed="false">3–8 лет</button>
          <button type="button" class="chip" data-f="age" data-v="senior" aria-pressed="false">Старше 8</button>
        </div>
        {traitSet.length > 0 && (
          <div class="filters__group" role="group" aria-label="Особенности">
            {traitSet.map((t) => <button type="button" class="chip chip--trait" data-f="trait" data-v={t} aria-pressed="false">{t}</button>)}
          </div>
        )}
      </form>

      <p class="muted small" id="count" aria-live="polite"></p>
      <div class="grid grid--4" id="animals">
        {all.map((a, i) => <AnimalCard animal={a} loading={i < 8 ? 'eager' : 'lazy'} />)}
      </div>
      <div class="empty card card--pad" id="empty" hidden>
        <p>Под такие условия сейчас никого нет — но приют привозит новых подопечных каждый месяц. Посмотрите <a href="#" data-reset>всех</a> или подпишитесь на <a href={config.vk.url} target="_blank" rel="noopener">группу ВКонтакте</a>.</p>
      </div>
      {animalsSource === 'seed' && (
        <p class="small muted" style="margin-top:16px">Пока показаны животные со старого сайта приюта. После подключения ВКонтакте список берётся из раздела «Товары» группы и обновляется автоматически. Полный актуальный список — <a href={`https://vk.com/market-${config.vk.groupId}`} target="_blank" rel="noopener">в группе</a>.</p>
      )}
    </div>
  </section>

  <section class="section section--alt" id="adopt">
    <div class="container two-col">
      <div>
        <div class="eyebrow">Забрать домой</div>
        <h2>Как проходит передача животного</h2>
        <p class="lede" style="font-size:1.05rem">Приют отдаёт животных по договору, с испытательным сроком 14 дней, только в собственное жильё в Петербурге и области. Это не бюрократия, а гарантия, что хвост не вернётся на улицу.</p>
        <ol class="steps">
          <li>Присмотрите животное здесь или в группе, позвоните руководителю: <a href={`tel:${config.contacts[0].tel}`}>{config.contacts[0].phone}</a>.</li>
          <li>Заполните <a href={config.vk.formUrl} target="_blank" rel="noopener">анкету</a> — её рассматривают до 48 часов.</li>
          <li>Приезжайте знакомиться: с собаками нужно 4–5 встреч, чтобы установить контакт.</li>
          <li>Договор, и приют сам привозит питомца в новый дом. Условие — кастрация до 12 месяцев, ежегодная вакцинация и обработки.</li>
        </ol>
        <div class="row">
          <a class="btn btn--primary" href={config.vk.formUrl} target="_blank" rel="noopener"><Icon name="doc" size={16} /> Заполнить анкету</a>
          <a class="btn btn--ghost" href={rules.url} target="_blank" rel="noopener">Полные правила в группе</a>
        </div>
      </div>
      {rules.text && (
        <div class="card card--pad prose small-prose">
          <h3>Правила словами приюта</h3>
          <div set:html={vkTextToHtml(rules.text)} />
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  const state: Record<string, string> = { kind: '', sex: '', age: '' };
  const traits = new Set<string>();
  const cards = [...document.querySelectorAll<HTMLElement>('#animals .animal-card')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const year = new Date().getFullYear();

  function apply() {
    let n = 0;
    for (const c of cards) {
      const y = Number(c.dataset.year || 0);
      const age = y ? year - y : null;
      const okAge =
        !state.age || (age !== null && ((state.age === 'young' && age < 3) || (state.age === 'adult' && age >= 3 && age <= 8) || (state.age === 'senior' && age > 8)));
      const cardTraits = (c.dataset.traits || '').split('|');
      const okTraits = [...traits].every((t) => cardTraits.includes(t));
      const ok = (!state.kind || c.dataset.kind === state.kind) && (!state.sex || c.dataset.sex === state.sex) && okAge && okTraits;
      c.hidden = !ok;
      if (ok) n++;
    }
    const w = n % 10 === 1 && n % 100 !== 11 ? 'подопечный' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? 'подопечных' : 'подопечных';
    count.textContent = `Показано: ${n} ${w}`;
    empty.hidden = n > 0;
  }

  document.querySelectorAll<HTMLButtonElement>('#filters .chip').forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.f!;
      const v = b.dataset.v!;
      if (f === 'trait') {
        traits.has(v) ? traits.delete(v) : traits.add(v);
        b.setAttribute('aria-pressed', String(traits.has(v)));
      } else {
        state[f] = v;
        document.querySelectorAll<HTMLButtonElement>(`#filters .chip[data-f="${f}"]`).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }
      const url = new URL(location.href);
      state.kind ? url.searchParams.set('kind', state.kind) : url.searchParams.delete('kind');
      history.replaceState(null, '', url);
      apply();
    }),
  );
  document.querySelector('[data-reset]')?.addEventListener('click', (e) => {
    e.preventDefault();
    (document.querySelector('#filters .chip[data-f="kind"][data-v=""]') as HTMLButtonElement)?.click();
    (document.querySelector('#filters .chip[data-f="sex"][data-v=""]') as HTMLButtonElement)?.click();
    (document.querySelector('#filters .chip[data-f="age"][data-v=""]') as HTMLButtonElement)?.click();
    traits.clear();
    document.querySelectorAll('#filters .chip--trait').forEach((x) => x.setAttribute('aria-pressed', 'false'));
    apply();
  });
  const initialKind = new URLSearchParams(location.search).get('kind');
  if (initialKind) (document.querySelector(`#filters .chip[data-f="kind"][data-v="${initialKind}"]`) as HTMLButtonElement)?.click();
  else apply();
</script>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 820px;
    margin-bottom: 24px;
  }
  .filters {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }
  .filters__group {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: var(--surface);
    font: 700 0.9rem var(--font-body);
    color: var(--ink-2);
    cursor: pointer;
    min-height: 38px;
  }
  .chip[aria-pressed='true'] {
    border-color: var(--green);
    background: var(--green-soft);
    color: var(--green);
  }
  .chip--trait {
    font-weight: 400;
  }
  .chip__n {
    font-weight: 400;
    color: var(--muted);
  }
  #count {
    margin: 0 0 12px;
  }
  .empty {
    margin-top: 12px;
  }
  .two-col {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
  }
  .two-col h2 {
    margin: 6px 0 12px;
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 16px 0 20px;
    padding-left: 1.2em;
  }
  .small-prose {
    font-size: 0.95rem;
  }
  .small-prose h3 {
    margin-bottom: 8px;
  }
</style>
